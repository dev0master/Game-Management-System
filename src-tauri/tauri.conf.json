{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameVault",
  "version": "0.1.0",
  "identifier": "com.gamevault.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GameVault",
        "width": 1320,
        "height": 860,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALAPPDATA/GameVault/covers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "nsis"
  }
}
